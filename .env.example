# Copy to .env (never commit .env). Everything is optional: the defaults run a fully working offline demo.

# --- FalkorDB (defaults match docker-compose.yml) ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# For FalkorDB Cloud, fill these from your instance page:
# FALKORDB_HOST=
# FALKORDB_PORT=
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=
# FALKORDB_SSL=true
# Or use a single URL if provided by your host:
# FALKORDB_URL=falkordbs://username:password@host:port

# --- Optional LLM, any OpenAI-compatible /chat/completions endpoint ---
# Leave LLM_API_KEY empty for offline mode (deterministic answers composed straight from graph facts).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Examples (check your provider's docs for the exact base URL and model names):
#   Google Gemini OpenAI-compatible endpoint:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Local Ollama:                               LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=llama3.1

# --- Server ---
HOST=127.0.0.1
PORT=8000
